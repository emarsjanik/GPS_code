# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
gnssrefl_venv/
venv/
.venv/

# GNSS generated data
raw/
rinex/
products/
logs/
archive/

# Database
database/

# Runtime logs anywhere in the tree (not just the top-level logs/)
*.log

# Archives -- not backed up
*.tar.gz
*.tar
*.zip
*.gz

# Raw/reference data files -- not backed up (documentation and code only)
*.rnx
*.snr*
*.um980
*.csv
*.xlsx
*.png

# Hardware/mechanical design files -- GNSS scripts and info only
3d enclosure models/

# OS files
.DS_Store
Thumbs.db
*.backup

# Stray gnssrefl working-directory output at the project root --
# always a sign REFL_CODE wasn't set before running gnssrefl tools
# (its real output belongs under products/refl_code/<year>/, never
# here). Anchored to the repo root only, matches any 4-digit year.
/[0-9][0-9][0-9][0-9]/

# A real station.json is created by ./setup_station.sh from the
# user's own answers. Only the template is tracked -- shipping one
# station's real coordinates to everyone else silently produces
# confident-looking, physically meaningless results.
station/resources/station.json

# One-off, station-specific admin scripts (kept outside the repo)
nuc_cleanup.sh
nuc_cleanup_round2.sh

# Per-deployment settings (bucket, station code, paths). Only the
# template is tracked -- see archive.conf.template.
archive.conf

# Manifests describing the tide model files, which are themselves
# data rather than code and not tracked here.
*.manifest.json
